{
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://pokemon-signin.firebaseapp.com/__/auth/:path*" },
    { "source": "/__/firebase/:path*", "destination": "https://pokemon-signin.firebaseapp.com/__/firebase/:path*" },
    { "source": "/impressum", "destination": "/index.html" },
    { "source": "/impressum/", "destination": "/index.html" },
    { "source": "/datenschutz", "destination": "/index.html" },
    { "source": "/datenschutz/", "destination": "/index.html" }
  ]
}
